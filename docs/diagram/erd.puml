@startuml erd
title ERD - Sistem Penyewaan Garasi Kendaraan
hide circle
skinparam linetype ortho

entity "users" as users {
  * id : bigint <<PK>>
  --
  nik : varchar(16) <<UNIQUE, nullable>>
  * name : varchar(255)
  phone : varchar(20)
  * email : varchar(255) <<UNIQUE>>
  * password : varchar(255)
  * role : enum(admin, renter)
  * status : enum(pending, approved, rejected)
  created_at, updated_at
}

entity "garages" as garages {
  * id : bigint <<PK>>
  --
  * code : varchar(4) <<UNIQUE>>
  * type : enum(bike, car, electric_car)
  * daily_price : int unsigned
  charging_price_per_kwh : int unsigned
  * status : enum(available, used)
  created_at, updated_at
}

entity "vehicles" as vehicles {
  * id : bigint <<PK>>
  --
  * user_id : bigint <<FK>>
  * type : enum(bicycle, motorcycle, car, electric_car)
  plate_number : varchar(15)
  * brand : varchar(255)
  * model : varchar(255)
  battery_kwh : decimal(6,2)
  created_at, updated_at
}

entity "rentals" as rentals {
  * id : bigint <<PK>>
  --
  * user_id : bigint <<FK>>
  * garage_id : bigint <<FK>>
  * vehicle_id : bigint <<FK>>
  * rental_type : enum(daily, monthly)
  created_at, updated_at
}

entity "invoices" as invoices {
  * id : bigint <<PK>>
  --
  * rental_id : bigint <<FK>>
  processed_by : bigint <<FK, nullable>>
  * type : enum(initial, extension)
  * start_date : date
  * end_date : date
  * duration_days : smallint unsigned
  * rent_fee : bigint unsigned
  * charging_fee : bigint unsigned
  * total_fee : bigint unsigned
  * payment_proof_path : varchar(255)
  created_at, updated_at
}

users ||--o{ vehicles : memiliki
users ||--o{ rentals : menyewa
garages ||--o{ rentals : disewa
vehicles ||--o{ rentals : menempati
rentals ||--|{ invoices : "ditagih (awal + perpanjangan)"
users |o--o{ invoices : "diproses (admin, perpanjangan)"

note bottom of rentals
  Index: user_id, (garage_id, vehicle_id)
  Rental tidak menyimpan tanggal/biaya;
  masa sewa = invoice pertama s.d. invoice terakhir.
end note
note bottom of invoices
  Index: (rental_id, end_date), start_date
  Invoice tidak punya garage_id: garasi selalu dari rentals.garage_id.
  type=initial : dibuat penyewa saat sewa baru (processed_by null)
  type=extension : dibuat Admin saat perpanjang, garasi SAMA dengan rental;
    start_date = end_date invoice sebelumnya,
    rent_fee = extra_days x garages.daily_price,
    charging_fee = 0 (isi daya sudah dibayar di invoice initial)
end note
note bottom of garages
  Index: (type, status)
end note
@enduml
